# ---------------------------------------------------------------------------
# Copia este archivo a .env.local y rellena los valores.
# Cada despliegue usa su propio proyecto de Firebase y su propia app de Meta.
# De dónde sale cada valor: docs/04-variables-de-entorno.md
# Mientras falten las seis de Firebase, el panel abre la guía de instalación
# (/instalar) en vez del login.
# ---------------------------------------------------------------------------

# --- Firebase (Configuración del proyecto → Tus apps → Web) -----------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=TU-PROYECTO.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=TU-PROYECTO
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=TU-PROYECTO.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Tu marca (opcional) ------------------------------------------------------
# Cómo te llamas en público: la política de privacidad y el asistente.
NEXT_PUBLIC_BRAND_NAME=Tu marca
# Tu sitio, sin slash final (ej. https://mimarca.com). El asistente lo menciona
# en los DMs que arma. Déjalo vacío si no tienes sitio.
NEXT_PUBLIC_SITE_URL=
# Tu zona horaria (nombre IANA: America/Bogota, Europe/Madrid…). Por defecto,
# la del centro de México.
NEXT_PUBLIC_TIMEZONE=

# --- App --------------------------------------------------------------------
# URL pública del panel, sin slash final. Debe coincidir con lo registrado en Meta.
# En local, la del túnel (ngrok, cloudflared) si vas a recibir webhooks.
APP_URL=http://localhost:3000

# Correos con acceso al panel, separados por coma.
# Si lo dejas vacío, el primero que inicie sesión queda como dueño.
ALLOWED_EMAILS=

# --- Meta / Instagram (developers.facebook.com) -----------------------------
META_APP_ID=
META_APP_SECRET=

# Cadena que inventas tú. Meta la repite al verificar el webhook.
META_WEBHOOK_VERIFY_TOKEN=

# --- Secretos ---------------------------------------------------------------
# Genera cada uno con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# --- Claude (console.anthropic.com → API Keys) ------------------------------
# El asistente que arma automatizaciones por ti. Sin ella, el resto funciona igual.
CLAUDE_API_KEY=
# Solo si la llave no pertenece a un workspace (la API responde 400 pidiendo
# anthropic-workspace-id). Es el id wrkspc_… de la consola; no es secreto.
CLAUDE_WORKSPACE_ID=

# --- Solo en local ----------------------------------------------------------
# En producción las credenciales vienen del entorno. En tu máquina, o corres
# `gcloud auth application-default login`, o pegas aquí el JSON de una cuenta
# de servicio en una sola línea:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Dominio del túnel con el que pruebas webhooks en local (sin https://), para
# que Next acepte las peticiones de dev que llegan por él. Opcional.
# DEV_TUNNEL_HOST=mi-tunel.ngrok-free.app
